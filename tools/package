#!/usr/bin/env bash
# Build the release zip: one ForeverConsumables folder with exactly what
# ./install copies, nothing else.
#   tools/package            -> dist/ForeverConsumables-<version>.zip
set -eu
HERE="$(cd "$(dirname "$0")/.." && pwd)"
VERSION="$(sed -n 's/^## Version: *//p' "$HERE/ForeverConsumables.toc" | tr -d '\r')"
STAGE="$(mktemp -d)"
trap 'rm -rf "$STAGE"' EXIT
"$HERE/install" "$STAGE" >/dev/null
mkdir -p "$HERE/dist"
OUT="$HERE/dist/ForeverConsumables-$VERSION.zip"
rm -f "$OUT"
(cd "$STAGE" && zip -qrX "$OUT" ForeverConsumables)
echo "$OUT"
